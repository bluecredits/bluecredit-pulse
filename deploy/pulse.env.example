# Pulse server functions — copy to /etc/bluecredit-pulse/pulse.env (install.sh does this) and fill in.
# This file holds secrets: it stays on the server (root:bcpulse, mode 640) and is never committed.

# Supabase project "pulse" → Project Settings → API
SUPABASE_URL=https://dtnohwaxnnwqplmdtdeq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_LSwFfqry2e6FfcEE_msnHw_dLzj910i
SUPABASE_SERVICE_ROLE_KEY=            # secret key — server only

# Chief of Staff (Claude) — console.anthropic.com → API keys
ANTHROPIC_API_KEY=
CHIEF_MODEL=claude-sonnet-5-5
CHIEF_DAILY_LIMIT=200                 # assistant requests per workspace per day

# Scheduler — where people use Pulse (comma-separated), and this server's public function address
SITE_URL=https://pulse.bluecredits.org,https://bluecredits.github.io/bluecredit-pulse
CALENDAR_FUNCTION_URL=https://pulse.bluecredits.org/fn/calendar
CALENDAR_SECRET=                      # install.sh fills a random value; changing it disconnects all calendars
CRON_SECRET=                          # install.sh fills a random value

# Google Cloud console → APIs & Services → Credentials → OAuth client (Web)
#   Authorized redirect URI: https://pulse.bluecredits.org/fn/calendar/callback/google
#   Enable "Google Calendar API"; scopes: calendar.freebusy, calendar.events, openid, email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra admin center → App registrations → New (accounts in any org + personal Microsoft accounts)
#   Redirect URI (Web): https://pulse.bluecredits.org/fn/calendar/callback/microsoft
#   API permissions (delegated): offline_access, openid, email, User.Read, Calendars.ReadWrite
MS_CLIENT_ID=
MS_CLIENT_SECRET=
