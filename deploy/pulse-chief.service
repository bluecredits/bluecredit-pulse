[Unit]
Description=Pulse AI chief of staff (calls Claude)
After=network-online.target
Wants=network-online.target

[Service]
User=bcpulse
Group=bcpulse
EnvironmentFile=/etc/bluecredit-pulse/pulse.env
Environment=PORT=8092 HOST=127.0.0.1 DENO_DIR=/opt/bluecredit-pulse/.deno
ExecStart=/usr/local/bin/deno run --allow-net --allow-env --cached-only /opt/bluecredit-pulse/functions/chief/index.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/bluecredit-pulse/functions
ReadWritePaths=/opt/bluecredit-pulse/.deno
MemoryMax=512M

[Install]
WantedBy=multi-user.target
